# Copy to .env and fill in. Never commit .env.
#
# `app/config.py` reads every variable below and nothing else; DATABASE_URL,
# when set, is honoured verbatim and overrides every POSTGRES_* part - a stale
# value in a machine's .env wins over the parts and breaks that machine
# quietly.

# `development` or `production`. Unset means production. Both dev machines
# need this set explicitly.
APP_ENV=development

# --- Database ---
# In development: `docker exec cg1618-dev-db createdb -U postgres
# travel` (see docs/registry.md) creates the `travel` database inside the
# shared container the PLATFORM owns - it is not media's, and no app's compose
# can remove it. Point at it with the container's own
# superuser role and leave DATABASE_URL unset - POSTGRES_HOST/POSTGRES_PORT
# default to localhost:5432, which is where dev.ps1 expects the container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=travel

# In production `bin/provision travel` writes POSTGRES_USER/PASSWORD/DB above
# directly - the password is generated on the box and never printed. Add the
# host yourself: the shared PostgreSQL answers to `db` on the cg1618 network,
# and the default `localhost` inside the app container is the app container.
# POSTGRES_HOST=db
#
# DATABASE_URL=
#   Honoured verbatim when set, overriding every POSTGRES_* part above. Leave
#   it unset in both environments - a value here would override the password
#   provision has just generated, and the first deploy would fail with
#   `password authentication failed`, pointing at the database rather than at
#   this file.

# --- Google Sheet backup ---
# Both optional: unset, the app starts normally and only the backup (POST
# /api/backup, scripts.backup_sheet) and the restore (scripts.restore_sheet)
# refuse, saying which one is missing. See docs/sheet-backup.md.
#
# GOOGLE_CREDENTIALS_JSON is the service account's key file as ONE line of
# compact JSON inside SINGLE quotes. It is a credential: it lives in .env only,
# is never committed, and is never pasted into a terminal, a commit or a chat.
#
# The quotes and the compactness are not style. On the box, bin/deploy and
# deploy/migrations source this file with bash, and JSON written with spaces
# after `:` and `,` splits into words that bash then tries to run as commands
# - which refuses the deploy before it starts. Single quotes make bash take
# the value literally (a key never contains one), and compose's env_file and
# the app's settings both strip them.
#
# Write it without printing it, from the downloaded key file:
#   python -c "import json,sys; print("GOOGLE_CREDENTIALS_JSON='" + json.dumps(json.load(open(sys.argv[1])), separators=(',', ':')) + "'")" key.json >> .env
# (python3 on the box). Check that bash can read the result:
#   bash -c 'set -a; . ./.env' && echo sourceable
# then move the downloaded key file somewhere private, outside every repository
# (the other machine and the box need it too; Google never shows a key twice).
# GOOGLE_CREDENTIALS_JSON=
#
# The id in the spreadsheet's URL, between /d/ and /edit. Production's is the
# "Travel" sheet; a development machine uses "Travel (dev)" and never
# Travel's id, because a backup overwrites the whole sheet. Both are the
# owner's, shared with the service account as an Editor, and hold booking
# codes, so neither is ever link-shared.
# GOOGLE_SHEET_ID=

# Compose derives its project name from the directory otherwise, which mounts a
# different volume. Pin it. Only read by docker-compose.prod.yml, on the box -
# travel has no docker-compose.yml of its own in development; the shared
# development database is the platform's docker-compose.dev-db.yml.
COMPOSE_PROJECT_NAME=travel
